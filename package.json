{
  "name": "bnc-docs",
  "productName": "BNC Docs",
  "version": "0.1.4",
  "description": "Open-source word processor with full .docx support and Nextcloud integration.",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "author": "BNC",
  "homepage": "https://docs.bncplayer.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PigeonBoi69/bnc-docs.git"
  },
  "bugs": {
    "url": "https://github.com/PigeonBoi69/bnc-docs/issues"
  },
  "desktopName": "bnc-docs.desktop",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win nsis portable",
    "icons": "node tools/make-icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist:linux": "vite build && electron-builder --linux deb AppImage",
    "version:bump": "tsx tools/bump-version.ts",
    "build:linux": "powershell -ExecutionPolicy Bypass -File tools/build-linux.ps1",
    "smoke:linux": "powershell -ExecutionPolicy Bypass -File tools/linux-smoke.ps1",
    "dist:mac": "vite build && electron-builder --mac zip --arm64 --x64",
    "build:mac": "powershell -ExecutionPolicy Bypass -File tools/build-mac.ps1",
    "check:mac": "powershell -ExecutionPolicy Bypass -File tools/mac-check.ps1"
  },
  "devDependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-font-family": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-subscript": "^3.31.4",
    "@tiptap/extension-superscript": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "docx": "^9.9.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "lucide": "^1.53.0",
    "marked": "^18.1.0",
    "turndown": "^7.2.4",
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.bncplayer.bncdocs",
    "productName": "BNC Docs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BNC Docs Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "BNC Docs Portable ${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": "bncdoc",
        "name": "BNC Docs Document",
        "description": "BNC Docs Document",
        "icon": "build/icon.ico",
        "role": "Editor",
        "mimeType": "application/x-bncdoc"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "executableName": "bnc-docs",
      "syncDesktopName": true,
      "category": "Office",
      "synopsis": "Open-source word processor with full .docx support",
      "description": "BNC Docs is an open-source word processor in the same family as BNC Presentation and BNC Sheets. It opens and saves Word (.docx) files, has its own .bncdoc format, and works with Nextcloud.",
      "maintainer": "BNC <noreply@bncplayer.com>",
      "artifactName": "BNC-Docs-${version}-${arch}.${ext}",
      "mimeTypes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "text/markdown",
        "text/html",
        "text/plain"
      ]
    },
    "deb": {
      "packageName": "bnc-docs",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libdrm2",
        "libxkbcommon0",
        "libcups2t64 | libcups2"
      ],
      "recommends": [
        "fonts-crosextra-carlito",
        "fonts-liberation",
        "fonts-crosextra-caladea"
      ]
    },
    "afterPack": "tools/mac-adhoc-sign.cjs",
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0",
      "artifactName": "BNC-Docs-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "BNC Docs",
        "NSHumanReadableCopyright": "MIT License"
      }
    }
  }
}
